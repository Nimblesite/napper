<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Types.Generated.fs is generated by `make generate-types` from Types.td
         (typeDiagram DSL, canonical source of truth). It is gitignored. -->
    <Compile Include="Types.Generated.fs" />
    <Compile Include="HttpMethodExtensions.fs" />
    <Compile Include="OpenApiTypes.fs" />
    <Compile Include="Logger.fs" />
    <Compile Include="ScriptDispatch.fs" />
    <Compile Include="Parser.fs" />
    <Compile Include="Environment.fs" />
    <Compile Include="ScriptContext.fs" />
    <Compile Include="Runner.fs" />
    <Compile Include="Output.fs" />
    <Compile Include="OpenApiGenerator.fs" />
    <Compile Include="HttpToNapConverter.fs" />
    <Compile Include="CurlGenerator.fs" />
    <Compile Include="SectionScanner.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FParsec" Version="1.1.1" />
    <PackageReference Include="Microsoft.OpenApi" Version="3.7.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotHttp\DotHttp.fsproj" />
  </ItemGroup>

</Project>
